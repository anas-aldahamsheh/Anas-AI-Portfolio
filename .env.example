# ==============================================================================
# Portfolio — environment variables
# Copy to .env.local for local development. Never commit real values.
# ==============================================================================

# Postgres (Neon in production). Needs the `vector` and `pg_trgm` extensions,
# which the migration enables. Use the pooled ("-pooler") connection string.
# Local Docker database (see README): postgresql://postgres:postgres@127.0.0.1:5439/portfolio_dev
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Better Auth (owner sign-in). 32+ random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the site (used for auth callbacks, metadata and the sitemap).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: canonical public URL when it differs from BETTER_AUTH_URL (on Vercel the
# deployment URL is detected automatically).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Gemini (assistant, embeddings, reranking, CV reading, translation).
# Get a key at https://aistudio.google.com/apikey (GOOGLE_AI_API_KEY is accepted as an alias).
GEMINI_API_KEY=
# Optional: embedding model (changing it requires "Rebuild AI index" in the admin).
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
