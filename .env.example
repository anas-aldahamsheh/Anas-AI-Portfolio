# ==============================================================================
# ANAS AI PORTFOLIO — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# NEVER commit .env or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL - Neon default target)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/portfolio?sslmode=require

# ------------------------------------------------------------------------------
# 3. Authentication (Better Auth)
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=your_minimum_32_character_random_auth_secret_string_here
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Master Encryption Key (Used for encrypting AI provider API keys at rest)
# Must be a 32-byte hexadecimal string (64 characters)
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 5. Vector Database (Qdrant)
# ------------------------------------------------------------------------------
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# ------------------------------------------------------------------------------
# 6. Cache & Rate Limiting (Upstash Redis)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ------------------------------------------------------------------------------
# 7. Blob Storage (S3-compatible for CV and media assets)
# ------------------------------------------------------------------------------
BLOB_STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
BLOB_STORAGE_REGION=us-east-1
BLOB_STORAGE_BUCKET=portfolio-assets
BLOB_STORAGE_ACCESS_KEY_ID=your_access_key_id
BLOB_STORAGE_SECRET_ACCESS_KEY=your_secret_access_key

# ------------------------------------------------------------------------------
# 8. Observability & Logging
# ------------------------------------------------------------------------------
# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
